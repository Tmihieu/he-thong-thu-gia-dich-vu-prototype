<mxfile host="app.diagrams.net" modified="2026-09-21T09:35:00.000Z" agent="Antigravity/3.1" version="24.7.5">
  <diagram id="Architecture4Roles" name="Kiến trúc Prototype 4 Vai Trò">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="KIẾN TRÚC TỔNG THỂ HỆ THỐNG QUẢN LÝ THU GIÁ DỊCH VỤ VSMT (PROTOTYPE V3.1)&#xa;Mô hình 4 vai trò tác nghiệp · Đồng bộ một nguồn dữ liệu thống nhất (Single Source of Truth)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fillColor=#1e293b;fontColor=#ffffff;strokeColor=none;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1570" height="60" as="geometry" />
        </mxCell>

        <!-- CONTAINER 1: QUẢN TRỊ HỆ THỐNG -->
        <mxCell id="grp_admin" value="1. QUẢN TRỊ HỆ THỐNG (System Administrator)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#4c1d95;fontStyle=1;fontSize=14;startSize=32;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="360" height="420" as="geometry" />
        </mxCell>
        <mxCell id="adm_users" value="Tài khoản &amp; Phân quyền (RBAC)&#xa;• Quản lý người dùng&#xa;• Phân quyền 4 vai trò&#xa;• Phạm vi dữ liệu (Toàn xã / Công ty)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;fontColor=#1e1b4b;fontSize=12;align=left;spacing=10;fontStyle=0;" vertex="1" parent="grp_admin">
          <mxGeometry x="20" y="45" width="320" height="75" as="geometry" />
        </mxCell>
        <mxCell id="adm_config" value="Cấu hình nghiệp vụ cốt lõi&#xa;• 3 Địa bàn (Đông Thạnh, Thới Tam Thôn, Nhị Bình)&#xa;• Danh mục 11 Đơn vị thu gom / Công ty&#xa;• Phiên bản Biểu giá &amp; Định mức (QĐ 65/2026/QĐ-UBND)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;fontColor=#1e1b4b;fontSize=12;align=left;spacing=10;fontStyle=0;" vertex="1" parent="grp_admin">
          <mxGeometry x="20" y="135" width="320" height="85" as="geometry" />
        </mxCell>
        <mxCell id="adm_periods" value="Quản lý Kỳ thu (Mở / Khóa kỳ)&#xa;• Mở kỳ theo Tháng hoặc Quý&#xa;• Kiểm tra điều kiện công nợ trước khi Khóa sổ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;fontColor=#1e1b4b;fontSize=12;align=left;spacing=10;fontStyle=0;" vertex="1" parent="grp_admin">
          <mxGeometry x="20" y="235" width="320" height="65" as="geometry" />
        </mxCell>
        <mxCell id="adm_logs" value="Nhật ký &amp; An toàn dữ liệu&#xa;• Audit logs chi tiết hành động người dùng&#xa;• Tạo &amp; kiểm tra bản sao lưu tự động/thủ công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;fontColor=#1e1b4b;fontSize=12;align=left;spacing=10;fontStyle=0;" vertex="1" parent="grp_admin">
          <mxGeometry x="20" y="315" width="320" height="65" as="geometry" />
        </mxCell>

        <!-- CONTAINER 2: CÁN BỘ XÃ -->
        <mxCell id="grp_commune" value="2. CÁN BỘ XÃ (Phòng Kinh tế)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontStyle=1;fontSize=14;startSize=32;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="430" y="110" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="com_subjects" value="Dữ liệu Hộ &amp; Hợp đồng&#xa;• Hộ gia đình / Hộ kinh doanh / Doanh nghiệp&#xa;• Nhóm giá, đối tượng miễn giảm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;fontColor=#0f172a;fontSize=12;align=left;spacing=8;" vertex="1" parent="grp_commune">
          <mxGeometry x="20" y="45" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="com_requests" value="Lập Phiếu Yêu cầu thu (YCT)&#xa;• Phát hành đợt thu theo kỳ cho các tổ dân phố&#xa;• Tự động sinh danh sách Khoản thu cho từng hộ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;fontColor=#0f172a;fontSize=12;align=left;spacing=8;" vertex="1" parent="grp_commune">
          <mxGeometry x="20" y="115" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="com_areas" value="Phân công 24 Khu vực (Tổ) cho Công ty&#xa;• Gán trách nhiệm gom rác &amp; thu tiền&#xa;• Giám sát tiến độ thu từng tổ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;fontColor=#0f172a;fontSize=12;align=left;spacing=8;" vertex="1" parent="grp_commune">
          <mxGeometry x="20" y="185" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="com_recon" value="Đối soát tổng thể &amp; Lập Phiếu thu&#xa;• Lập Phiếu thu (PT) khi công ty nộp tiền về xã&#xa;• Đối soát: Chênh lệch = Đã nộp xã − Đã thu của hộ&#xa;• Theo dõi nợ các kỳ trước &amp; gửi nhắc nhở" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;fontStyle=1;align=left;spacing=8;" vertex="1" parent="grp_commune">
          <mxGeometry x="20" y="255" width="340" height="75" as="geometry" />
        </mxCell>
        <mxCell id="com_complaints" value="Tiếp nhận &amp; Điều phối Khiếu nại&#xa;• Tiếp nhận qua điện thoại / trực tiếp / app dân&#xa;• Chuyển cho công ty môi trường phụ trách xử lý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;fontColor=#0f172a;fontSize=12;align=left;spacing=8;" vertex="1" parent="grp_commune">
          <mxGeometry x="20" y="340" width="340" height="60" as="geometry" />
        </mxCell>

        <!-- CONTAINER 3: CÔNG TY MÔI TRƯỜNG -->
        <mxCell id="grp_company" value="3. CÔNG TY MÔI TRƯỜNG (Actor linh hoạt)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;fontColor=#14532d;fontStyle=1;fontSize=14;startSize=32;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="840" y="110" width="380" height="420" as="geometry" />
        </mxCell>
        <mxCell id="cop_actor" value="Bộ chuyển Actor linh hoạt&#xa;• Cho phép đổi sang bất kỳ công ty nào (DV01-DV11)&#xa;• Tự động nạp dữ liệu tổ, người thu, khoản thu tương ứng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbf7d0;strokeColor=#16a34a;fontColor=#064e3b;fontSize=12;fontStyle=1;align=left;spacing=8;" vertex="1" parent="grp_company">
          <mxGeometry x="20" y="45" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cop_assigned" value="Quản lý Hộ được giao theo kỳ&#xa;• Xem chỉ tiêu Phải thu / Đã thu / Còn phải thu&#xa;• Danh sách hộ gia đình &amp; hộ kinh doanh được giao&#xa;• Phân bổ tuyến / tổ cho người đi thu nội bộ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontColor=#0f172a;fontSize=12;align=left;spacing=8;" vertex="1" parent="grp_company">
          <mxGeometry x="20" y="115" width="340" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cop_collectors" value="Giám sát Người đi thu &amp; Tiền mặt&#xa;• Theo dõi kết quả từng nhân viên (Tiền mặt / Chuyển khoản)&#xa;• Xác nhận bàn giao tiền mặt từ người thu về công ty&#xa;• Cảnh báo tiền mặt còn giữ chưa nộp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontColor=#0f172a;fontSize=12;align=left;spacing=8;" vertex="1" parent="grp_company">
          <mxGeometry x="20" y="200" width="340" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cop_receipts" value="Xem Phiếu thu xã lập &amp; Xử lý Khiếu nại&#xa;• Xem các phiếu thu xã đã lập cho công ty, báo sai sót&#xa;• Giải quyết khiếu nại xã giao (trong hạn 3 ngày)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontColor=#0f172a;fontSize=12;align=left;spacing=8;" vertex="1" parent="grp_company">
          <mxGeometry x="20" y="285" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="cop_remit" value="Nộp tiền phần xử lý về tài khoản ngân sách xã" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#14532d;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="grp_company">
          <mxGeometry x="20" y="360" width="340" height="40" as="geometry" />
        </mxCell>

        <!-- CONTAINER 4: NGƯỜI ĐI THU -->
        <mxCell id="grp_collector" value="4. NGƯỜI ĐI THU (Collector Mobile / Web)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontColor=#78350f;fontStyle=1;fontSize=14;startSize=32;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1250" y="110" width="360" height="420" as="geometry" />
        </mxCell>
        <mxCell id="col_list" value="Danh sách hộ được giao theo ca&#xa;• Lọc theo tuyến đường, tổ dân phố&#xa;• Hiển thị trạng thái: Chưa thu, Đã thu, Đã hẹn, Vắng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fde68a;fontColor=#0f172a;fontSize=12;align=left;spacing=8;" vertex="1" parent="grp_collector">
          <mxGeometry x="20" y="45" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="col_update" value="Cập nhật kết quả thu từng hộ&#xa;• Thu tiền mặt hoặc Chuyển khoản&#xa;• Ghi nhận vắng nhà, hẹn ngày quay lại&#xa;• Đồng bộ tức thì lên hệ thống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fde68a;fontColor=#0f172a;fontSize=12;align=left;spacing=8;" vertex="1" parent="grp_collector">
          <mxGeometry x="20" y="125" width="320" height="75" as="geometry" />
        </mxCell>
        <mxCell id="col_receipt" value="Xuất Biên lai điện tử tức thì&#xa;• Sinh mã biên lai tự động (BL-0926-XXXX)&#xa;• Gửi biên lai qua Zalo/SMS cho người dân" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=1;align=left;spacing=8;" vertex="1" parent="grp_collector">
          <mxGeometry x="20" y="210" width="320" height="65" as="geometry" />
        </mxCell>
        <mxCell id="col_handover" value="Bàn giao tiền mặt về công ty&#xa;• Theo dõi tổng tiền mặt đang giữ&#xa;• Tạo phiếu bàn giao cuối ca / cuối kỳ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fde68a;fontColor=#0f172a;fontSize=12;align=left;spacing=8;" vertex="1" parent="grp_collector">
          <mxGeometry x="20" y="285" width="320" height="65" as="geometry" />
        </mxCell>
        <mxCell id="col_app" value="Giao diện giả lập App Mobile tiện lợi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#f97316;fontColor=#7c2d12;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="grp_collector">
          <mxGeometry x="20" y="360" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- DATA LAYER: SINGLE SOURCE OF TRUTH -->
        <mxCell id="grp_data" value="TẦNG DỮ LIỆU CỐT LÕI DÙNG CHUNG (SINGLE SOURCE OF TRUTH)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontStyle=1;fontSize=14;startSize=32;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1570" height="280" as="geometry" />
        </mxCell>

        <mxCell id="db_charges" value="BẢNG KHOẢN THU (CS_CHARGES)&#xa;Mã khoản · Mã YCT · Mã hộ · Số tiền · Kỳ thu · Trạng thái (Chưa thu / Đã thu / Quá hạn / Miễn giảm)&#xa;&#xa;* Nguồn dữ liệu chung: Cán bộ xã thấy để giám sát, Công ty thấy để quản lý, Người thu thấy để đi thu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=12;fontStyle=0;align=left;spacing=12;" vertex="1" parent="grp_data">
          <mxGeometry x="30" y="45" width="460" height="100" as="geometry" />
        </mxCell>

        <mxCell id="db_areas" value="ĐỊA BÀN &amp; PHÂN CÔNG (MANAGEMENT_AREAS / UNITS)&#xa;24 Tổ dân phố · Số hộ · Hiệu lực hợp đồng · Đơn vị thu gom &amp; Đơn vị thu tiền&#xa;&#xa;* Xã gán khu vực cho công ty nào, công ty đó toàn quyền điều phối người thu nội bộ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=12;fontStyle=0;align=left;spacing=12;" vertex="1" parent="grp_data">
          <mxGeometry x="520" y="45" width="510" height="100" as="geometry" />
        </mxCell>

        <mxCell id="db_receipts" value="PHIẾU THU XÃ LẬP (CS_COMPANY_RECEIPTS)&#xa;Mã phiếu thu · Mã công ty · Kỳ thu · Số tiền · Hình thức · Mã ngân hàng/chứng từ&#xa;&#xa;* Xã lập mỗi lần công ty nộp tiền; công ty chỉ xem đối chiếu, không tự kê khai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=12;fontStyle=0;align=left;spacing=12;" vertex="1" parent="grp_data">
          <mxGeometry x="1060" y="45" width="480" height="100" as="geometry" />
        </mxCell>

        <mxCell id="db_complaints" value="DANH SÁCH KHIẾU NẠI (CS_COMPLAINTS)&#xa;Mã KN · Người gửi · Tổ/Khu vực · Công ty phụ trách · Nội dung · Hạn xử lý (3 ngày) · Kết quả phản hồi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=12;fontStyle=0;align=left;spacing=10;" vertex="1" parent="grp_data">
          <mxGeometry x="30" y="160" width="460" height="70" as="geometry" />
        </mxCell>

        <mxCell id="db_handovers" value="NHẬT KÝ THU &amp; BÀN GIAO (RS_CONFIRMED / HANDOVERS)&#xa;Xác nhận thu từng hộ (Tiền mặt/CK) · Lịch sử nộp tiền mặt của nhân viên về thủ quỹ công ty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=12;fontStyle=0;align=left;spacing=10;" vertex="1" parent="grp_data">
          <mxGeometry x="520" y="160" width="510" height="70" as="geometry" />
        </mxCell>

        <mxCell id="db_reconcile" value="CƠ CHẾ ĐỐI SOÁT TỔNG THỂ KHÔNG LẪN LỘN&#xa;Chênh lệch = [Tiền công ty nộp về xã (Phiếu thu)] − [Tiền đã thu của hộ (Người thu báo)]&#xa;Tiền thu của dân thuộc công ty; xã chỉ giám sát và nhận nộp phần tiền xử lý theo quy định." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;align=left;spacing=10;" vertex="1" parent="grp_data">
          <mxGeometry x="1060" y="160" width="480" height="70" as="geometry" />
        </mxCell>

        <!-- FLOW CONNECTORS -->
        <!-- Admin to Config -->
        <mxCell id="flow_adm_data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.2;entryY=0;entryDx=0;entryDy=0;strokeColor=#8b5cf6;strokeWidth=2;" edge="1" parent="1" source="adm_config" target="db_areas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_adm_data" value="Cấu hình &amp; Biểu giá" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#6d28d9;background=#ffffff;" vertex="1" connectable="0" parent="flow_adm_data">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Commune to Charges -->
        <mxCell id="flow_com_charges" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2563eb;strokeWidth=2;" edge="1" parent="1" source="com_requests" target="db_charges">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_com_charges" value="1. Phát hành YCT sinh khoản thu" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1d4ed8;background=#ffffff;" vertex="1" connectable="0" parent="flow_com_charges">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Collector updates Charges -->
        <mxCell id="flow_col_charges" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.8;entryY=0;entryDx=0;entryDy=0;strokeColor=#f59e0b;strokeWidth=2;" edge="1" parent="1" source="col_update" target="db_charges">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_col_charges" value="2. Xác nhận đã thu tiền hộ" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#b45309;background=#ffffff;" vertex="1" connectable="0" parent="flow_col_charges">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Collector to Company Handover -->
        <mxCell id="flow_col_cop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;strokeColor=#f59e0b;strokeWidth=2;dashed=1;" edge="1" parent="1" source="col_handover" target="cop_collectors">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_col_cop" value="Bàn giao tiền mặt" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#b45309;background=#ffffff;" vertex="1" connectable="0" parent="flow_col_cop">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Company to Commune Remit -->
        <mxCell id="flow_cop_com" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;strokeColor=#16a34a;strokeWidth=2;" edge="1" parent="1" source="cop_remit" target="com_recon">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_cop_com" value="3. Chuyển tiền phần xử lý về xã" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#15803d;background=#ffffff;" vertex="1" connectable="0" parent="flow_cop_com">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Commune Receipts to Company -->
        <mxCell id="flow_com_receipts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.2;entryY=0;entryDx=0;entryDy=0;strokeColor=#2563eb;strokeWidth=2;" edge="1" parent="1" source="com_recon" target="db_receipts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl_com_receipts" value="4. Lập phiếu thu chính thức" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1d4ed8;background=#ffffff;" vertex="1" connectable="0" parent="flow_com_receipts">
          <mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
