# Sao chép thành .env rồi đổi giá trị. .env không được commit (xem .gitignore).
# Mọi giá trị dưới đây là giá trị giả, chỉ dùng cho máy dev.

POSTGRES_DB=vsmt
POSTGRES_USER=vsmt
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_PORT=5432

# Khóa ký JWT, tối thiểu 32 ký tự. Thiếu biến này thì backend không khởi động (T06).
JWT_SECRET=thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu

# Thư mục lưu ảnh người dân tải lên (vsmt.upload-dir); đường dẫn tương đối tính từ thư mục chạy backend.
# Xóa dòng này (không để trống giá trị) thì dùng mặc định uploads. Ổ chứa thư mục còn dưới 1 GB trống thì backend từ chối ảnh mới.
UPLOAD_DIR=uploads

# Cổng mở ra máy host khi chạy cả backend và web bằng docker compose up --build (T49).
BACKEND_PORT=8080
WEB_PORT=5173
