# Ảnh web cho Render. Build context là GỐC repo (render.yaml: dockerContext .) vì ảnh gồm cả app người dân
# (mobile-flutter) phục vụ ở /citizen. Chạy tay: docker build -f web/Dockerfile.render .

# App người dân bản web: cùng phiên bản Flutter với máy phát triển.
FROM debian:bookworm-slim AS citizen
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch 3.47.6 https://github.com/flutter/flutter.git /flutter
ENV PATH=/flutter/bin:$PATH
RUN flutter config --no-analytics && flutter precache --web
WORKDIR /app
COPY mobile-flutter/pubspec.yaml mobile-flutter/pubspec.lock ./
RUN flutter pub get
COPY mobile-flutter/ ./
RUN flutter build web --release --base-href /citizen/

FROM node:22-slim AS build
WORKDIR /src
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ .
RUN npm run build

FROM nginx:stable-alpine
COPY web/nginx.render.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /src/dist /usr/share/nginx/html
COPY --from=citizen /app/build/web /usr/share/nginx/html/citizen
ENV PORT=10000
EXPOSE 10000
