map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${PORT};
    root /usr/share/nginx/html;

    # Render's private hostname is stable; the official nginx entrypoint
    # substitutes BACKEND_HOST and PORT when the container starts.
    location /api/ {
        client_max_body_size 50m;
        proxy_pass http://${BACKEND_HOST}:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    # Jmix Admin: service riêng, nhúng vào trang admin bằng iframe cùng origin. Cần WebSocket cho Vaadin Push.
    location /jmix/ {
        proxy_pass http://${JMIX_HOST}:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        # Jmix gửi X-Frame-Options: DENY; cùng origin thì cho nhúng.
        proxy_hide_header X-Frame-Options;
        add_header X-Frame-Options SAMEORIGIN always;
    }

    # Probe backend readiness too; Swagger is already public in Spring Security.
    location = /healthz {
        proxy_pass http://${BACKEND_HOST}:8080/v3/api-docs;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
