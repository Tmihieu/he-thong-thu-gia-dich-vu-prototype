# nginx trên điện thoại (Termux): gom web, /api và /jmix về một cổng giống bản Render.
# setup.sh thay @ROOT@ (thư mục cài) và @PREFIX@ (thư mục usr của Termux) rồi ghi ra run/nginx.conf.
worker_processes 1;
pid @ROOT@/run/nginx.pid;
error_log @ROOT@/logs/nginx-error.log;

events {
    worker_connections 256;
}

http {
    include @PREFIX@/etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    access_log off;

    client_body_temp_path @ROOT@/run/nginx-tmp/body;
    proxy_temp_path @ROOT@/run/nginx-tmp/proxy;
    fastcgi_temp_path @ROOT@/run/nginx-tmp/fastcgi;
    uwsgi_temp_path @ROOT@/run/nginx-tmp/uwsgi;
    scgi_temp_path @ROOT@/run/nginx-tmp/scgi;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 8088;
        root @ROOT@/web;

        location /api/ {
            client_max_body_size 50m;
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_connect_timeout 10s;
            proxy_read_timeout 60s;
        }

        # Jmix Admin nhúng vào trang admin bằng iframe cùng origin; cần WebSocket cho Vaadin Push.
        location /jmix/ {
            proxy_pass http://127.0.0.1:8081;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
            proxy_hide_header X-Frame-Options;
            add_header X-Frame-Options SAMEORIGIN always;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
