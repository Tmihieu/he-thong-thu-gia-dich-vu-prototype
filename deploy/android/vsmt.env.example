# Cấu hình chạy trên điện thoại. setup.sh chép file này thành vsmt.env; sửa vsmt.env, không sửa file này.

# PostgreSQL của Termux (cụm mặc định ở $PREFIX/var/lib/postgresql).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vsmt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# setup.sh tự sinh nếu để trống.
JWT_SECRET=

# Domain tĩnh miễn phí ở https://dashboard.ngrok.com → Domains. Authtoken đặt bằng `ngrok config add-authtoken`.
NGROK_DOMAIN=

# Bộ nhớ tối đa cho mỗi service Java (máy ~3,5 GB RAM).
BACKEND_XMX=320m
JMIX_XMX=320m
