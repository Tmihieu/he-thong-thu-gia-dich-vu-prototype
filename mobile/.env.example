# Địa chỉ backend nhìn từ điện thoại: IP LAN của laptop (ipconfig → "IPv4 Address" của Wi-Fi), cổng 8080.
# Chép thành .env.local rồi sửa IP. Không dùng localhost: trên điện thoại localhost là chính điện thoại.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080
# Điền sẵn SĐT + OTP demo ở màn đăng nhập; đặt false khi dùng dữ liệu thật.
EXPO_PUBLIC_DEMO_LOGIN=true
